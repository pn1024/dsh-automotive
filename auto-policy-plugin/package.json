{
  "name": "dsh-plugin-automotive",
  "version": "1.0.1",
  "description": "汽车产业研究台：国内汽车政策库（官方原文）、销量与品牌份额、奇瑞官方公告、上市公司财报与一致预期，带条款级原文定位、政策-财报季度对照和公文格式研究报告",
  "private": false,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "data/*.json",
    "scripts",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "汽车",
    "汽车产业",
    "汽车政策",
    "新能源汽车",
    "automotive",
    "auto-industry",
    "policy",
    "research",
    "dashboard"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "check-sources": "node scripts/sources.mjs check",
    "backup": "node scripts/backup.mjs snapshot"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
