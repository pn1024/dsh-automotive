{
  "name": "dsh-plugin-auto-policy",
  "version": "1.0.0",
  "description": "汽车政策研究台：真实政策与销量、可下钻面板、条款原文定位和证据化月度报告",
  "private": false,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "data/*.json",
    "scripts",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "automotive",
    "policy",
    "nev",
    "research",
    "dashboard"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "check-sources": "node scripts/sources.mjs check",
    "backup": "node scripts/backup.mjs snapshot"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}